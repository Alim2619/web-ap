{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-ap",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "5e31e993-3c16-4c7e-bea1-1b19440c3371","database_name": "web-ap" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "d7c9a29f51ae4995a1e4300cb9c73d72" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
